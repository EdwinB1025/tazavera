# Template of .env.prod (the API's settings): install.sh copies it to .env.prod
# on the first run and fills in the empty values. Comments on their own line only.

APP_NAME=Tazavera
APP_ENV=production
APP_DEBUG=false
# Generated once by install.sh and kept
APP_KEY=
# The public address: install.sh writes PUBLIC_ORIGIN of .env here
APP_URL=
# The public address: install.sh writes PUBLIC_ORIGIN of .env here
FRONT_URL=
# The compose subnet: the front's forwarded headers are trusted
TRUSTED_PROXIES=172.30.0.0/24
SESSION_SECURE_COOKIE=true
LOG_CHANNEL=stderr
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=tazavera_api
DB_USERNAME=tazavera
# DB_PASSWORD is not here: the compose passes it from .env
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
# A real mailer before real users
MAIL_MAILER=log
