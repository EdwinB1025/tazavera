# Template of .env: install.sh copies it to .env on the first run and fills it in.
# The real .env holds secrets and never goes to git.

# The ngrok domain, with https://, no trailing slash (asked by install.sh)
PUBLIC_ORIGIN=
# The ngrok authtoken (asked by install.sh)
NGROK_AUTHTOKEN=
# Database password of the app user (generated by install.sh)
DB_PASSWORD=
# Database root password (generated by install.sh)
DB_ROOT_PASSWORD=
